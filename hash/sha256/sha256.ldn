-- SHA-256, as FIPS 180-4 defines it.
--
-- This is an integrity hash and nothing more: it tells whether two byte
-- strings are the same content.  It makes no constant-time claim, so it is
-- not for secrets, keys or anything an attacker times.
--
-- A hash is made in steps, so that content need never be in memory whole:
--
--     mut running := sha256.start()
--     sha256.add(running, first)
--     sha256.add(running, second)
--     sum: sha256.digest = sha256.finish(running)
--
-- The module depends on nothing but the language, so that it can leave
-- this package for a library of its own.

--- The 32 bytes of a finished hash, first byte first as FIPS 180-4 prints
--- them.
public digest: type = [32]u8

--- A digest as 64 lowercase hexadecimal digits.
public spelling: type = [64]u8

--- A hash in the making.  Make one with `start`; a copy goes its own way
--- from where the original stood.
public state: type = struct
    --  The eight working words, H0 to H7.
    words: [8]u32
    --  The bytes that do not fill a block yet, `held` of them.
    block: [64]u8
    held: usize
    --  How many bytes were added in all.
    total: u64
end state

--  The first 32 bits of the fractional parts of the cube roots of the
--  first 64 primes (FIPS 180-4, 4.2.2).
constants: [64]u32 = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1,
    0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786,
    0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147,
    0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
    0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,
    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

--- A hash of nothing yet.
public start: () -> (running: state) =
    --  The first 32 bits of the fractional parts of the square roots of
    --  the first eight primes (FIPS 180-4, 5.3.3).
    running = (words: [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
                       0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
               of zeroed)
end start

--- Take `bytes` into the hash, after everything added before.
public add: (inout running: state, bytes: []u8) -> none =
    running.total = running.total +% u64(lenof bytes)
    mut rest: []u8 = bytes
    if running.held > 0 then
        --  Fill the block that was begun.
        while running.held < 64 and lenof rest > 0 do
            running.block[running.held] = rest[0]
            inc running.held
            rest = rest[1..<lenof rest]
        end while
        return when running.held < 64
        full: [64]u8 = running.block
        mixed(running.words, full[0..<64])
        running.held = 0
    end if
    while lenof rest >= 64 do
        mixed(running.words, rest[0..<64])
        rest = rest[64..<lenof rest]
    end while
    for byte in rest do
        running.block[running.held] = byte
        inc running.held
    end for
end add

--- End the hash and give its digest.  The state is used up: start anew
--- for another hash.
public finish: (inout running: state) -> (sum: digest) =
    --  The message ends with a one bit, zeros up to 56 bytes of a block,
    --  and its length in bits as eight bytes, most significant first.
    bits: u64 = running.total *% 8
    mut tail: [72]u8 = zeroed
    tail[0] = 0x80
    zeros: usize = (119 - running.held) % 64
    mut at: usize = 0
    while at < 8 do
        tail[1 + zeros + at] = u8((bits >> u64(56 - 8 * at)) & 0xff)
        inc at
    end while
    add(running, tail[0..<zeros + 9])
    sum = zeroed
    for index in usize(0)..<8 do
        word: u32 = running.words[index]
        sum[4 * index] = u8((word >> 24) & 0xff)
        sum[4 * index + 1] = u8((word >> 16) & 0xff)
        sum[4 * index + 2] = u8((word >> 8) & 0xff)
        sum[4 * index + 3] = u8(word & 0xff)
    end for
end finish

--- The digest of `bytes` alone.
public of: (bytes: []u8) -> (sum: digest) =
    mut running := start()
    add(running, bytes)
    sum = finish(running)
end of

--- `sum` as 64 lowercase hexadecimal digits.
public hex: (sum: digest) -> (text: spelling) =
    digits: []u8 = "0123456789abcdef"
    text = zeroed
    for index in usize(0)..<32 do
        text[2 * index] = digits[usize(sum[index] >> 4)]
        text[2 * index + 1] = digits[usize(sum[index] & 15)]
    end for
end hex

--  One block of 64 bytes into the eight words (FIPS 180-4, 6.2.2).
mixed: (inout words: [8]u32, block: []u8) -> none =
    mut w: [64]u32 = zeroed
    for t in usize(0)..<16 do
        w[t] = (u32(block[4 * t]) << 24) | (u32(block[4 * t + 1]) << 16)
               | (u32(block[4 * t + 2]) << 8) | u32(block[4 * t + 3])
    end for
    for t in usize(16)..<64 do
        x: u32 = w[t - 15]
        y: u32 = w[t - 2]
        small0: u32 = ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14))
                      ^ (x >> 3)
        small1: u32 = ((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13))
                      ^ (y >> 10)
        w[t] = w[t - 16] +% small0 +% w[t - 7] +% small1
    end for
    mut a: u32 = words[0]
    mut b: u32 = words[1]
    mut c: u32 = words[2]
    mut d: u32 = words[3]
    mut e: u32 = words[4]
    mut f: u32 = words[5]
    mut g: u32 = words[6]
    mut h: u32 = words[7]
    for t in usize(0)..<64 do
        big1: u32 = ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21))
                    ^ ((e >> 25) | (e << 7))
        choice: u32 = (e & f) ^ (~e & g)
        first: u32 = h +% big1 +% choice +% constants[t] +% w[t]
        big0: u32 = ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19))
                    ^ ((a >> 22) | (a << 10))
        majority: u32 = (a & b) ^ (a & c) ^ (b & c)
        second: u32 = big0 +% majority
        h = g
        g = f
        f = e
        e = d +% first
        d = c
        c = b
        b = a
        a = first +% second
    end for
    words[0] = words[0] +% a
    words[1] = words[1] +% b
    words[2] = words[2] +% c
    words[3] = words[3] +% d
    words[4] = words[4] +% e
    words[5] = words[5] +% f
    words[6] = words[6] +% g
    words[7] = words[7] +% h
end mixed
