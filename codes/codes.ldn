-- The codes refine-build's refusals carry, and what each one means.
--
-- This is the one place a code is spelled and explained.  A refusal names
-- its code by the atom declared here, so the tool can print no code this
-- file does not explain: `spelled` and `about` each match every atom, and
-- a missing arm does not compile.
--
-- The prefix `RB` is the one `refine-build --describe` claims, so that
-- `refine explain RB0102` is forwarded here (Landin's D1385).  Landin's
-- own codes start with `L` and are never ours.

import dev701/refine_build/text/strings

--- The prefix every code here starts with, as `--describe` claims it.
public prefix: []u8 = "RB"

public command_line: atom
public file_unread: atom
public host_refused: atom
public no_refine: atom
public line_unreadable: atom
public keyword_unknown: atom
public line_shape: atom
public said_twice: atom
public package_name: atom
public line_missing: atom
public rule_runs_nothing: atom
public placeholder: atom
public name_unknown: atom
public steps_circle: atom
public input_unknown: atom
public step_shadows_path: atom
public program_missing: atom
public program_unstarted: atom
public step_failed: atom
public tree_unhashable: atom
public store_unusable: atom
public store_nowhere: atom
public lock_missing: atom
public lock_stale: atom
public entry_missing: atom
public package_wrong: atom
public import_undeclared: atom
public tool_wrong: atom
public git_missing: atom
public git_failed: atom
public version_untagged: atom
public tags_differ: atom
public commit_unknown: atom
public tree_differs: atom
public not_a_package: atom
public versions_clash: atom
public locations_clash: atom
public pins_clash: atom
public name_unlocked: atom

--- One kind of thing the tool refuses.
public code: type =
    command_line | file_unread | host_refused | no_refine | line_unreadable |
    keyword_unknown | line_shape | said_twice | package_name | line_missing |
    rule_runs_nothing | placeholder | name_unknown |
    steps_circle | input_unknown | step_shadows_path | program_missing |
    program_unstarted | step_failed | tree_unhashable | store_unusable |
    store_nowhere |
    lock_missing |
    lock_stale |
    entry_missing |
    package_wrong |
    import_undeclared |
    tool_wrong |
    git_missing |
    git_failed |
    version_untagged |
    tags_differ |
    commit_unknown |
    tree_differs |
    not_a_package |
    versions_clash |
    locations_clash |
    pins_clash |
    name_unlocked

--- No code is spelled that way.
public unknown: atom

--- Every code, in the order `refine-build explain` lists them.
all: [39]code = [command_line, file_unread, host_refused, no_refine,
                 line_unreadable, keyword_unknown, line_shape, said_twice,
                 package_name, line_missing, rule_runs_nothing,
                 placeholder, name_unknown, steps_circle, input_unknown,
                 step_shadows_path, program_missing, program_unstarted,
                 step_failed, tree_unhashable, store_unusable, store_nowhere,
                 lock_missing,
                 lock_stale,
                 entry_missing,
                 package_wrong,
                 import_undeclared,
                 tool_wrong,
                 git_missing,
                 git_failed,
                 version_untagged,
                 tags_differ,
                 commit_unknown,
                 tree_differs,
                 not_a_package,
                 versions_clash,
                 locations_clash,
                 pins_clash,
                 name_unlocked]

--- How many codes there are.
public count: () -> (number: usize) =
    number = lenof all
end count

--- The code at `index` of the list, which is below `count()`.
public at: (index: usize) -> (which: code) =
    which = all[index]
end at

--- The code `spelling` spells, as `RB0102` does `keyword_unknown`.
public named: (spelling: []u8) -> (which: code) ! unknown =
    for candidate in all do
        if strings.same(spelled(candidate), spelling) then
            which = candidate
            return
        end if
    end for
    fail unknown
end named

--- How `which` is spelled where the tool prints it.
public spelled: (which: code) -> (spelling: []u8) =
    match which
        command_line: spelling = "RB0001"
        file_unread: spelling = "RB0002"
        host_refused: spelling = "RB0003"
        no_refine: spelling = "RB0004"
        line_unreadable: spelling = "RB0101"
        keyword_unknown: spelling = "RB0102"
        line_shape: spelling = "RB0103"
        said_twice: spelling = "RB0104"
        package_name: spelling = "RB0201"
        line_missing: spelling = "RB0202"
        rule_runs_nothing: spelling = "RB0301"
        placeholder: spelling = "RB0302"
        name_unknown: spelling = "RB0303"
        steps_circle: spelling = "RB0304"
        input_unknown: spelling = "RB0305"
        step_shadows_path: spelling = "RB0306"
        program_missing: spelling = "RB0401"
        program_unstarted: spelling = "RB0402"
        step_failed: spelling = "RB0403"
        tree_unhashable: spelling = "RB0501"
        store_unusable: spelling = "RB0601"
        store_nowhere: spelling = "RB0602"
        lock_missing: spelling = "RB0203"
        lock_stale: spelling = "RB0204"
        entry_missing: spelling = "RB0205"
        package_wrong: spelling = "RB0206"
        import_undeclared: spelling = "RB0207"
        tool_wrong: spelling = "RB0208"
        git_missing: spelling = "RF0001"
        git_failed: spelling = "RF0002"
        version_untagged: spelling = "RF0101"
        tags_differ: spelling = "RF0102"
        commit_unknown: spelling = "RF0103"
        tree_differs: spelling = "RF0104"
        not_a_package: spelling = "RF0105"
        versions_clash: spelling = "RF0201"
        locations_clash: spelling = "RF0202"
        pins_clash: spelling = "RF0203"
        name_unlocked: spelling = "RF0204"
    end match
end spelled

--- What `refine-build explain` says about `which`.
public about: (which: code) -> (words: []u8) =
    match which
        command_line: words = """
            The command line is not one the program understands: an option
            it does not have, an option without its value, or a code that
            `explain` does not know. `refine-build --help` and
            `refine-fetch --help` list the options. The status is 2.
            """
        file_unread: words = """
            A file the build needs is not there or cannot be read.
            refine-build runs in a package's directory, which holds
            `landin.package`, the description, and `landin.recipe`, the
            recipe. The message names the file and what the host said.
            """
        host_refused: words = """
            The host refused something the tool asked of it: memory, a
            directory, a link or a write under `.landin/`. The message
            carries the host's reason. Nothing in the two files is wrong;
            look at the disk, the permissions of `.landin/` and the memory
            the process may take.
            """
        no_refine: words = """
            A `run` line's first word is `refine`, which means the refine
            that started this build, and none is known. `refine build`
            tells the tool which refine ran it. Run by its own name, the
            tool takes `--refine PATH`, and without it the first `refine`
            on PATH; here there was none, or the path names no program.
            """
        line_unreadable: words = """
            A line cannot be cut into words. A word in double quotes has to
            close on its line and takes Landin's escapes, `\n`, `\t`,
            `\"`, `\\` and `\u{...}`; a quote inside a bare word is not
            one. The message says what stopped the reader.
            """
        keyword_unknown: words = """
            Every line starts with a keyword, and this one starts with a
            word that is none. A description's are `package`, `kind`,
            `licence`, `program`, `needs` and `uses`; a recipe's are
            `rule`, `run`, `set`, `step` and `default`. A comment is the
            word `--` followed by a space, so `--root` is a word and no
            comment.
            """
        line_shape: words = """
            The keyword is known and the words after it are not what it
            takes: too few, too many, or one of the wrong form. The message
            gives the line's form. In a recipe this is also a `run` or
            `set` with no `rule` or `step` before it, and a step's inputs
            without `from` or `with`.
            """
        said_twice: words = """
            Something that is there once is there twice: a second `kind` or
            `package` line, a program, rule or step named twice, a package
            listed twice among `needs` and `uses`, or a second `run` in one
            rule. Remove one, or give one of the two another name. A rule
            runs one program; a second program is a second rule and step.
            """
        package_name: words = """
            A package's name is `owner/name`. Both halves become
            directories in an import path, so each is lowercase letters,
            digits and `_` and starts with a letter or `_`. The owners
            `core`, `hosted`, `platform` and `landin` are the library's
            and the toolchain's and own no package.
            """
        line_missing: words = """
            The description lacks a line it needs: `package owner/name`,
            which every description has, or, for `kind program`, a
            `program NAME MODULE` line for each executable.
            """
        rule_runs_nothing: words = """
            A rule has no `run` line, so a step that names it would start
            nothing. Write `run PROGRAM WORDS...` under the rule.
            """
        placeholder: words = """
            A `{name}` in a `run` line and the `set` lines do not agree.
            `{out}` is the step's output directory and `{in}` its `from`
            inputs; `{in}` stands for several words and is a word of its
            own. Any other `{name}` needs a `set name VALUE` under the step
            or the rule, a `set` that no `run` line uses is refused, and a
            brace itself is written `{{` or `}}`.
            """
        name_unknown: words = """
            A name names nothing: a step names a rule the recipe does not
            have, `default` names a step it does not have, or the command
            line asks for one. The message gives the name; check its
            spelling against the recipe.
            """
        steps_circle: words = """
            A step takes an input from a step that, directly or through
            others, takes one from it. A step runs after every step it
            names, so there is no order to run these in. One of them has to
            stop naming the other.
            """
        input_unknown: words = """
            An input after `from` or `with` is `packages`, the name of a
            step, or a path inside the project: no `..`, not starting with
            `/`, and a file or directory that exists. This one is none of
            them.
            """
        step_shadows_path: words = """
            A step has the name of a file or directory in the project, so
            an input of that name could mean either. Give the step another
            name.
            """
        program_missing: words = """
            The program a step runs was not found. A first word with a `/`
            is a path in the step's view, so the program has to be an input
            of the step or inside one; any other word is looked for on
            PATH. Each step is started through `env -C`, so `env` has to be
            on PATH as well.
            """
        program_unstarted: words = """
            The program was found and the host would not start it, or the
            tool lost it while it ran. The message carries the host's
            reason; a file that is not executable is the usual one.
            """
        step_failed: words = """
            A step's program ended with a status other than 0, or a signal
            ended it. What the program said is above the message. The build
            stops at the first step that fails, and its status is 1.
            """
        tree_unhashable: words = """
            A directory tree's content hash has a place for files,
            directories and symbolic links and for nothing else. The path
            in the message is a socket, a device or a named pipe, or a link
            whose target is longer than 4096 bytes, or it was named as a
            tree's root and is no directory. Remove it, or leave the
            directory that holds it out of what is hashed.
            """
        store_unusable: words = """
            The store keeps what steps made, so that a step whose program
            and inputs are the same as before is not run again. The
            directory named is no store this refine-build can use: its
            `version` file names another form, written by another version
            of the tool, or it holds entries and names no form at all. Use
            the version of the tool that wrote it, name another directory
            with `--store PATH`, or remove the directory: everything in a
            store can be made again, and its entries are read-only, so
            `chmod -R u+w` it first.
            """
        store_nowhere: words = """
            The store is per user: `$XDG_CACHE_HOME/landin/store` when that
            variable holds an absolute path, and else
            `$HOME/.cache/landin/store`. Neither variable says where, so
            name the store's directory with `--store PATH`.
            """
        lock_missing: words = """
            The description has a `needs` or `uses` line and the package's
            directory has no `landin.lock`. The lock says which commit and
            which content each package is, and `refine-build` builds only
            from what it says: it fetches nothing. Run `refine-fetch` in the
            package's directory; it writes the lock and fetches what is
            missing. Keep the lock with the package's sources.
            """
        lock_stale: words = """
            The lock does not say what the description asks for: a location
            that has no line, a line whose version is earlier than the one
            asked for or across a breaking change from it, or another commit
            than the one named. The description changed after the lock was
            written. Run `refine-fetch`, which changes the lines that have
            to change and no others.
            """
        entry_missing: words = """
            The lock names a package whose content is not in the store, as
            after the lock came from someone else or the store was removed.
            Run `refine-fetch`: it fetches the commit the lock names and
            refuses content that is not what the lock says.
            """
        package_wrong: words = """
            A package is not what it was taken for. A local path holds no
            `landin.package`; two packages in one program have the same
            name, which only one may have; the content the lock names is
            described under another name than the lock gives; or a package
            that was fetched needs a local path, which only the package
            being built and its local packages may.
            """
        import_undeclared: words = """
            A source file imports a module of a package that the file's own
            package does not list. A package may import its own modules, the
            library's (`core`, `hosted`, `platform`, `landin`) and those of
            the packages its description `needs`; that another package
            brings one along is not enough, since it may stop doing so. Add
            a `needs` line for the package, or remove the import. The
            imports are found by reading each `.ldn` file's lines that start
            with `import`, not by the compiler.
            """
        tool_wrong: words = """
            A `uses` line names a package that gives the recipe no program:
            its description has no `program` line. A tool is a package of
            `kind program` whose programs the tool compiles and the recipe's
            `run` lines name by their first word.
            """
        git_missing: words = """
            `refine-fetch` fetches with git, which it starts as `git` from
            PATH, and there is none. Install git. Nothing else fetches: how
            a location is reached, with which credentials and through which
            proxy, is all git's configuration.
            """
        git_failed: words = """
            git ended with a status other than 0. What it said is above the
            message, and the message gives the words it was started with.
            The usual reasons are a location that does not exist, a host
            that cannot be reached and credentials git does not have; `git
            ls-remote https://LOCATION` asks the same of git by hand.
            """
        version_untagged: words = """
            A package is asked for at a version, and the repository at its
            location has no tag for it. The version `2.3.1` is the tag
            `v2.3.1` or the tag `2.3.1`. Ask for a version that is tagged,
            or name a commit: `needs LOCATION commit FORTY-HEX-DIGITS`.
            """
        tags_differ: words = """
            The repository has both the tag `v2.3.1` and the tag `2.3.1`,
            and they name different commits, so the version means two
            things. Whoever keeps the repository has to remove one; until
            then, name the commit you mean.
            """
        commit_unknown: words = """
            A commit named in the description or in the lock is not in the
            repository at the location, or is on none of its branches and
            tags, which is all that is fetched. Check the forty digits and
            the location.
            """
        tree_differs: words = """
            The lock names a commit and the content hash that commit had
            when the lock was written, and what was fetched for that commit
            now hashes differently. The content is not what was locked, so
            it is refused. Nothing a commit's name covers can change, so
            look for a checkout that differs on this machine: a git filter,
            or line-end settings. `refine-fetch --update NAME` writes the
            lock anew from what is there now.
            """
        not_a_package: words = """
            What was fetched has no `landin.package` in its root, or one
            that cannot be read, so it is no Landin package. The message
            names the location.
            """
        versions_clash: words = """
            Two packages need one package at versions with a breaking change
            between them: another major, or below 1.0.0 another minor. A
            program holds one version of a package, so there is none that
            serves both. The message names both that ask. One of them has to
            move to the other's version.
            """
        locations_clash: words = """
            Two locations hold a package of the same name, and a program
            holds a name once. When the description of the package being
            built names one of them itself, in a `needs` line, that one is
            taken for every package and a note says so: that is how a fork
            stands in for the original. Here it names neither, so add such a
            line for the one you want.
            """
        pins_clash: words = """
            One package is asked for at a commit by one and at a version, or
            at another commit, by another, and neither is the package being
            built, whose choice would stand. Name the commit or the version
            you want in a `needs` line of the package being built.
            """
        name_unlocked: words = """
            `--update NAME` names a package the lock has no line for. Give
            the names as the lock spells them, `owner/name`, or no name to
            choose every package's version anew.
            """
    end match
end about
