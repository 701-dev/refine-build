-- refine-build: runs a package's recipe.  It is a contributed command of
-- `refine`, which runs a `refine-NAME` on PATH as `refine NAME`.
--
--     refine-build [--refine PATH] [--store PATH] [--again] [--raw]
--                  [--check] [STEP...]
--     refine-build explain [CODE]
--     refine-build --describe
--     refine-build --complete -- WORD...
--
-- Run in a package's directory, it reads `landin.package` and
-- `landin.recipe`, says everything that is wrong in them, and runs the
-- steps asked for, or the recipe's `default` steps, or every step when it
-- names none.  Each runs after the steps it takes inputs from.  What a
-- step makes is kept in the user's store, or the one `--store` names, and a
-- step whose program and inputs are what they were is not run but kept;
-- `--again` runs every step whatever the store keeps.  What a step's
-- program says is passed on with its paths through the view made the
-- project's; `--raw` passes it on as it is.
--
-- The last three are what `refine` asks of a command it dispatches
-- (Landin's D1385, D1387 and D1485): what a code means, what the command is
-- and which codes are its own, and how the word being typed could end.
--
-- `--repeat N` is for the tool's own tests and is not in the help: it does
-- the whole build N times in this one process, as a watch mode would, so
-- that a test can see that the memory in use does not grow with N.
--
-- `--hash-file PATH` and `--hash-tree PATH` are for the tests as well, and
-- not in the help either.  The first prints the SHA-256 of a file, read
-- `--chunk N` bytes at a time when that is given; the second the content
-- hash of a directory tree (see `hash/tree`), without the entries of its
-- root that each `--leave NAME` names.

import core/failure
import core/io
import core/region
import core/text
import core/vec
import hosted/blocking
import hosted/heap
import dev701/refine_build/codes
import dev701/refine_build/command
import dev701/refine_build/description
import dev701/refine_build/files
import dev701/refine_build/hash/file
import dev701/refine_build/hash/sha256
import dev701/refine_build/hash/tree
import dev701/refine_build/lifetime
import dev701/refine_build/recipe
import dev701/refine_build/report
import dev701/refine_build/steps
import dev701/refine_build/text/lines
import dev701/refine_build/text/strings

package_file: []u8 = "landin.package"
recipe_file: []u8 = "landin.recipe"
lock_file: []u8 = "landin.lock"
missing: []u8 = "not found; run refine-build in a package's directory, which holds its landin.package and landin.recipe"

usage: []u8 = """usage: refine-build [--refine PATH] [--store PATH] [--again] [--raw]
                        [--check] [STEP...]
           refine-build explain [CODE]

    Run in a package's directory: reads landin.package and landin.recipe
    and runs the steps named, or the recipe's default steps.  A step
    whose program and inputs are what they were is kept, not run.

      --refine PATH   the refine that `refine` in a run line means;
                      without it, the refine that ran this command,
                      and then the first refine on PATH
      --store PATH    the store that keeps what steps made; without it,
                      $XDG_CACHE_HOME/landin/store, or else
                      $HOME/.cache/landin/store
      --again         run every step, whatever the store keeps
      --raw           pass on what a step's program says as it is; without
                      it, a path the program names through its view,
                      packages/OWNER/NAME/..., is shown as the project's
      --check         read and check the two files, and run nothing
      -h, --help      print this and exit

    `explain CODE` says what a code such as RB0102 means, and `explain`
    alone lists the codes.
    """

--  What `--describe` answers: Landin's `landin-command-1`, one JSON object
--  that names the command, gives the line `refine help` shows for it, and
--  claims the prefix of its codes.
description_answer: []u8 = """{"format":"landin-command-1","name":"build","summary":"Run the steps of a package's recipe","codes":["RB"]}"""

--- What the command line asks the tool to be.
building: atom
describing: atom
explaining: atom
completing: atom

--- What the command line asked for.
options: type = struct
    mode: building | describing | explaining | completing
    refine: []u8
    store: []u8
    again: bool
    raw: bool
    check_only: bool
    help: bool
    repeat: usize
    wanted: vec.list([]u8)
    hash_file: []u8
    hash_tree: []u8
    chunk: usize
    leave: vec.list([]u8)
end options

public main: () -> (code: i32) =
    host := blocking.new()
    --  The one place the heap is taken.  Everything below is given a
    --  region over it, or the heap itself as the parent of one (see
    --  `lifetime`).
    parent := heap.new()
    --  The command line lives as long as the process.
    mut ledger: lifetime.ledger = zeroed
    memory := region.over(ledger, parent)
    defer region.release(ledger, parent)
    code = 0
    asked: options = arguments(host, memory) else (problem)
        code = if problem == command.wrong_usage then 2 else 1 end if
        return
    end
    if asked.help then
        io.write(host, io.out(host), usage) else none
        return
    end if
    match asked.mode
        describing: begin
            io.write(host, io.out(host), description_answer) else none
            io.write(host, io.out(host), "\n") else none
            return
        end
        explaining: begin
            code = command.explained(host, "refine-build", vec.used(asked.wanted))
            return
        end
        completing: begin
            completed(host, memory, vec.used(asked.wanted))
            return
        end
        building: code = 0
    end match
    if lenof asked.hash_file > 0 or lenof asked.hash_tree > 0 then
        code = hashed(host, parent, asked)
        return
    end if
    mut round: usize = 0
    while round < asked.repeat do
        build(host, parent, asked) else (problem)
            _ = problem
            code = 1
            return
        end
        inc round
    end while
end main

--  One build: read and check the two files, and run the steps asked for.
--  Everything it allocates is in a region of its own, released when the
--  build has ended, however it ended, so a build can be repeated.
build: (host: blocking.host, parent: lifetime.parent, asked: options)
       -> none ! report.refused =
    mut ledger: lifetime.ledger = zeroed
    memory := region.over(ledger, parent)
    defer region.release(ledger, parent)
    package_source: []u8 = try command.content(host, memory, package_file,
                                               missing)
    about: description.description =
        description.read(host, memory, package_file, package_source)
        else (problem)
            command.said(host, problem)
            fail report.refused
        end
    recipe_source: []u8 = try command.content(host, memory, recipe_file,
                                              missing)
    plan: recipe.recipe =
        recipe.read(host, memory, recipe_file, recipe_source) else (problem)
            command.said(host, problem)
            fail report.refused
        end
    request: steps.request = (package_file: package_file,
                              recipe_file: recipe_file,
                              lock_file: lock_file,
                              refine: asked.refine, store: asked.store,
                              again: asked.again, raw: asked.raw)
    try steps.fits(host, parent, request, plan)
    mut targets := vec.new(item: usize)
    for name in vec.used(asked.wanted) do
        index: usize = recipe.step_named(plan, name) else (problem)
            _ = problem
            report.say(host, codes.name_unknown,
                       ["no step `", name, "` in ", recipe_file,
                        "; name one of its steps, or none for its defaults"])
            fail report.refused
        end
        try listed(host, memory, targets, index)
    end for
    if vec.length(targets) == 0 then
        for index in vec.used(plan.defaults) do
            try listed(host, memory, targets, index)
        end for
    end if
    if vec.length(targets) == 0 then
        for index in usize(0)..<vec.length(plan.steps) do
            try listed(host, memory, targets, index)
        end for
    end if
    return when asked.check_only
    sequence: vec.list(usize) =
        recipe.order(memory, plan, vec.used(targets)) else (problem)
            command.said(host, problem)
            fail report.refused
        end
    try steps.run(host, memory, parent, request, about, plan,
                  vec.used(sequence))
end build

--  Read the command line.  What it gives lives as long as `memory`.
arguments: (host: blocking.host, memory: lifetime.memory)
           -> (asked: options) ! report.refused | command.wrong_usage =
    asked = (mode: building, refine: "", store: "", again: false, raw: false,
             check_only: false, help: false,
             repeat: 1, wanted: vec.new(item: []u8), hash_file: "",
             hash_tree: "", chunk: 0, leave: vec.new(item: []u8))
    count: usize = io.argument_count(host)
    mut at: usize = 0
    while at < count do
        word: []u8 = try command.argument(host, memory, at)
        inc at
        if asked.mode <> building then
            --  The words after `explain` and `--complete` are theirs, and
            --  no option of the build's.
            vec.push(asked.wanted, memory, word) else (problem)
                command.said(host, problem)
                fail report.refused
            end
        elsif at == 1 and strings.same(word, "--describe") then
            asked.mode = describing
        elsif at == 1 and strings.same(word, "explain") then
            asked.mode = explaining
        elsif at == 1 and strings.same(word, "--complete") then
            asked.mode = completing
        elsif strings.same(word, "--help") or strings.same(word, "-h") then
            asked.help = true
        elsif strings.same(word, "--check") then
            asked.check_only = true
        elsif strings.same(word, "--again") then
            asked.again = true
        elsif strings.same(word, "--raw") then
            asked.raw = true
        elsif strings.same(word, "--store") then
            asked.store = try command.value(host, memory, at, count, word, "PATH")
            inc at
        elsif strings.same(word, "--refine") then
            if at == count then
                report.say(host, codes.command_line, ["`--refine` takes a path: `--refine PATH`"])
                fail command.wrong_usage
            end if
            asked.refine = try whole_path(host, memory,
                                          try command.argument(host, memory, at))
            inc at
        elsif strings.same(word, "--repeat") then
            if at == count then
                report.say(host, codes.command_line, ["`--repeat` takes a count: `--repeat N`"])
                fail command.wrong_usage
            end if
            times: []u8 = try command.argument(host, memory, at)
            asked.repeat = text.parse_usize(times) else (problem)
                _ = problem
                report.say(host, codes.command_line,
                           ["`--repeat ", times,
                            "`: the count is a whole number"])
                fail command.wrong_usage
            end
            inc at
        elsif strings.same(word, "--hash-file") then
            asked.hash_file = try command.value(host, memory, at, count, word, "PATH")
            inc at
        elsif strings.same(word, "--hash-tree") then
            asked.hash_tree = try command.value(host, memory, at, count, word, "PATH")
            inc at
        elsif strings.same(word, "--leave") then
            name: []u8 = try command.value(host, memory, at, count, word, "NAME")
            inc at
            vec.push(asked.leave, memory, name) else (problem)
                command.said(host, problem)
                fail report.refused
            end
        elsif strings.same(word, "--chunk") then
            size: []u8 = try command.value(host, memory, at, count, word, "N")
            inc at
            asked.chunk = text.parse_usize(size) else (problem)
                _ = problem
                report.say(host, codes.command_line,
                           ["`--chunk ", size,
                            "`: the size is a whole number of bytes"])
                fail command.wrong_usage
            end
        elsif strings.starts(word, "-") then
            report.say(host, codes.command_line,
                       ["unknown option `", word,
                        "`; `refine-build --help` lists the options"])
            fail command.wrong_usage
        else
            vec.push(asked.wanted, memory, word) else (problem)
                command.said(host, problem)
                fail report.refused
            end
        end if
    end while
    if asked.mode == building and lenof asked.refine == 0 then
        asked.refine = try caller(host, memory)
    end if
end arguments

--  `--hash-file` and `--hash-tree`: print the hash as 64 hexadecimal
--  digits and a line end.  The status is 0, or 1 when something could not
--  be hashed, which was said.
hashed: (host: blocking.host, parent: lifetime.parent, asked: options)
        -> (status: i32) =
    status = 1
    mut sum: sha256.digest = zeroed
    if lenof asked.hash_file > 0 then
        held: file.content =
            file.of(host, asked.hash_file, asked.chunk) else (problem)
                _ = problem
                return
            end
        sum = held.sum
    else
        sum = tree.of_tree(host, parent, asked.hash_tree,
                           vec.used(asked.leave)) else (problem)
            _ = problem
            return
        end
    end if
    spelled: sha256.spelling = sha256.hex(sum)
    io.write(host, io.out(host), spelled[0..<64]) else none
    io.write(host, io.out(host), "\n") else none
    status = 0
end hashed

--  The refine that dispatched this command, which it names in
--  `LANDIN_REFINE` as an absolute path (Landin's D1486), or nothing when
--  the tool was run by its own name or the host could not name it.
caller: (host: blocking.host, memory: lifetime.memory) -> (path: []u8)
        ! report.refused =
    path = ""
    named: text.host_string =
        io.variable_named(host, text.host_over("LANDIN_REFINE"))
        else (problem)
            _ = problem
            return
        end
    given: []u8 = text.host_bytes(named)
    return when lenof given == 0
    return when given[0] <> u8('/')
    path = strings.keep(memory, given) else (problem)
        command.said(host, problem)
        fail report.refused
    end
end caller

--  `--complete -- WORD...`: the words after the command's name up to the
--  one being typed, which is last and may be empty.  Answers with the ways
--  that word could end, one a line: an option, a code after `explain`, or
--  a step of the recipe in this directory.  A recipe that cannot be read
--  gives no steps and no complaint: a completion says nothing but words.
completed: (host: blocking.host, memory: lifetime.memory, given: [][]u8)
           -> none =
    mut words: [][]u8 = given
    if lenof words > 0 and strings.same(words[0], "--") then
        words = words[1..<lenof words]
    end if
    return when lenof words == 0
    typed: []u8 = words[lenof words - 1]
    if lenof words > 1 then
        before: []u8 = words[lenof words - 2]
        return when strings.same(before, "--refine")
        return when strings.same(before, "--store")
        if strings.same(words[0], "explain") then
            return when lenof words > 2
            command.codes_offered(host, typed)
            return
        end if
    end if
    if strings.starts(typed, "-") then
        command.offered(host, typed, "--again")
        command.offered(host, typed, "--check")
        command.offered(host, typed, "--help")
        command.offered(host, typed, "--raw")
        command.offered(host, typed, "--refine")
        command.offered(host, typed, "--store")
        return
    end if
    if lenof words == 1 then command.offered(host, typed, "explain") end if
    source: []u8 = files.read_all(host, memory, recipe_file) else (problem)
        _ = problem
        return
    end
    read: lines.document = lines.read(memory, source) else (problem)
        _ = problem
        return
    end
    for item in vec.used(read.lines) do
        named: [][]u8 = vec.used(item.words)
        if lenof named > 1 and strings.same(named[0], "step") then
            command.offered(host, typed, named[1])
        end if
    end for
end completed

--  The absolute path of the program `given` names: a step's program runs
--  in the step's view, where a relative path would mean another file.
whole_path: (host: blocking.host, memory: lifetime.memory, given: []u8)
            -> (path: []u8) ! report.refused =
    found: []u8 = files.program(host, memory, given) else (problem)
        _ = problem
        report.say(host, codes.no_refine, ["`--refine ", given, "`: no such program on PATH"])
        fail report.refused
    end
    if found[0] == u8('/') then
        path = found
        return
    end if
    project: []u8 = files.working(host, memory) else (problem)
        command.said(host, problem)
        fail report.refused
    end
    path = strings.joined(memory, [project, "/", found]) else (problem)
        command.said(host, problem)
        fail report.refused
    end
end whole_path

listed: (host: blocking.host, memory: lifetime.memory,
         inout targets: vec.list(usize), index: usize)
        -> none ! report.refused =
    vec.push(targets, memory, index) else (problem)
        command.said(host, problem)
        fail report.refused
    end
end listed
