-- The recipe, `landin.recipe`: the steps that build a package.
--
--     rule NAME
--         run  PROGRAM WORDS...
--         set  NAME VALUE
--     step NAME RULE [from INPUT...] [with INPUT...]
--         set  NAME VALUE
--     step NAME [from INPUT...] [with INPUT...]
--         run  PROGRAM WORDS...
--         set  NAME VALUE
--     default STEP...
--
-- Every line starts with a keyword; `run` and `set` belong to the `rule` or
-- `step` before them, and indentation means nothing.  A step names a rule,
-- or has a `run` line of its own and names none: the word after its name
-- is then `from`, `with` or missing, so no rule is called `from` or `with`.
-- `set always yes` under a step is the tool's own: the step runs every
-- time, whatever the store keeps (see `steps`).  A `run` line is a
-- word list, started directly and never given to a shell.  In it, `{out}`
-- is the step's output directory, `{in}` the step's `from` inputs, each a
-- word, and `{NAME}` what a `set NAME` of the step or of the rule gave;
-- `{{` and `}}` are single braces.  An input is `packages`, another step's
-- name, or a path in the project.

import core/mem
import core/vec
import hosted/blocking
import dev701/refine_build/codes
import dev701/refine_build/lifetime
import dev701/refine_build/report
import dev701/refine_build/text/lines
import dev701/refine_build/text/strings

--- A `set` line: a name and the value `{name}` stands for.
public setting: type = struct
    name: []u8
    value: []u8
    number: usize
end setting

--- A rule: how to run a program.  `run_number` is 0 while it has no `run`
--- line.  A step with a `run` line of its own has a rule of its own, `own`,
--- which carries the step's name.
public rule: type = struct
    name: []u8
    own: bool
    number: usize
    run: vec.list([]u8)
    run_number: usize
    sets: vec.list(setting)
end rule

--- A step: a rule applied to inputs.  `direct` are its `from` inputs, which
--- `{in}` names, and `beside` its `with` inputs, which are only made
--- visible.  `rule_at` is its rule's index once the recipe is checked.
public step: type = struct
    name: []u8
    number: usize
    own: bool
    rule_name: []u8
    rule_at: usize
    direct: vec.list([]u8)
    beside: vec.list([]u8)
    sets: vec.list(setting)
end step

--- A recipe as read and checked.  `defaults` are indices into `steps`.
public recipe: type = struct
    rules: vec.list(rule)
    steps: vec.list(step)
    defaults: vec.list(usize)
end recipe

--- The `set` name that is the tool's own: `set always yes` under a step
--- has it run every time.
public always: []u8 = "always"

--- The input every step may name: the packages the description needs, and
--- the package itself, each under its owner/name path.
public packages: []u8 = "packages"

--- No step has the name asked for.
public no_such_step: atom

nowhere: atom
in_rule: atom
in_step: atom
--  What a `run` or `set` line belongs to.
place: type = nowhere | in_rule | in_step

--- Read the recipe in `source`, which is the content of `file`, and check
--- it.  Everything wrong in it is said, each with its line, and then the
--- read fails `report.refused`.
public read: (host: blocking.host, memory: lifetime.memory, file: []u8,
              source: []u8) -> (result: recipe)
             ! report.refused | mem.out_of_memory =
    result = (rules: vec.new(item: rule), steps: vec.new(item: step),
              defaults: vec.new(item: usize))
    doc := try lines.read(memory, source)
    mut default_names := vec.new(item: lines.line)
    mut wrong: bool = false
    mut where: place = nowhere
    for item in vec.used(doc.lines) do
        read_line(host, memory, file, item, result, where, default_names)
            else (problem)
            fail mem.out_of_memory when problem == mem.out_of_memory
            wrong = true
        end
    end for
    fail report.refused when wrong
    try check(host, memory, file, result, vec.used(default_names))
end read

--- The index of the step called `name`.
public step_named: (value: recipe, name: []u8) -> (index: usize)
                   ! no_such_step =
    for item, at in vec.used(value.steps) do
        if strings.same(item.name, name) then
            index = at
            return
        end if
    end for
    fail no_such_step
end step_named

read_line: (host: blocking.host, memory: lifetime.memory, file: []u8,
            escaping item: lines.line, inout into: recipe, inout where: place,
            inout default_names: vec.list(lines.line))
           -> none ! report.refused | mem.out_of_memory =
    if item.state <> lines.sound then
        report.at_line(host, codes.line_unreadable, file, item.number, [lines.words_of(item.state)])
        fail report.refused
    end if
    words: [][]u8 = vec.used(item.words)
    keyword: []u8 = words[0]
    given: usize = lenof words - 1
    if strings.same(keyword, "rule") then
        where = nowhere
        try wants(host, file, item.number, given == 1,
                  "`rule` takes one word: `rule NAME`")
        try wants(host, file, item.number,
                  not strings.same(words[1], "from")
                  and not strings.same(words[1], "with"),
                  "a rule cannot be named `from` or `with`: after a step's name they start its inputs; give the rule another name")
        for other in vec.used(into.rules) do
            continue when other.own
            try unlike(host, file, item.number, "rule", other.name, words[1])
        end for
        made: rule = (name: words[1], own: false, number: item.number,
                      run: vec.new(item: []u8), run_number: 0,
                      sets: vec.new(item: setting))
        try vec.push(into.rules, memory, made)
        where = in_rule
    elsif strings.same(keyword, "step") then
        where = nowhere
        try wants(host, file, item.number, given >= 1,
                  "`step` takes a name, and a rule unless it has a `run` line of its own: `step NAME RULE from INPUT... with INPUT...`")
        try wants(host, file, item.number,
                  not strings.same(words[1], "explain"),
                  "a step cannot be named `explain`, since `refine-build explain CODE` explains a code; give the step another name")
        for other in vec.used(into.steps) do
            try unlike(host, file, item.number, "step", other.name, words[1])
        end for
        --  Without a rule's name the step has a rule of its own, which its
        --  `run` line fills.
        own: bool = given == 1 or strings.same(words[2], "from")
                    or strings.same(words[2], "with")
        first: usize = if own then usize(2) else usize(3) end if
        mut made: step = (name: words[1], number: item.number, own: own,
                          rule_name: "", rule_at: 0,
                          direct: vec.new(item: []u8),
                          beside: vec.new(item: []u8),
                          sets: vec.new(item: setting))
        if own then
            made.rule_at = vec.length(into.rules)
            alone: rule = (name: words[1], own: true, number: item.number,
                           run: vec.new(item: []u8), run_number: 0,
                           sets: vec.new(item: setting))
            try vec.push(into.rules, memory, alone)
        else
            made.rule_name = words[2]
        end if
        mut direct: bool = false
        mut chosen: bool = false
        for word in words[first..<lenof words] do
            if strings.same(word, "from") then
                direct = true
                chosen = true
            elsif strings.same(word, "with") then
                direct = false
                chosen = true
            elsif not chosen then
                report.at_line(host, codes.line_shape, file, item.number,
                               ["`", word,
                                "` follows the rule's name; write `from` before the inputs `{in}` names and `with` before those only made visible"])
                fail report.refused
            elsif direct then
                try vec.push(made.direct, memory, word)
            else
                try vec.push(made.beside, memory, word)
            end if
        end for
        try vec.push(into.steps, memory, made)
        where = in_step
    elsif strings.same(keyword, "run") then
        try wants(host, file, item.number, where <> nowhere,
                  "`run` belongs to a rule, or to a step that names none; write `rule NAME` or `step NAME` on a line before it")
        try wants(host, file, item.number, given >= 1,
                  "`run` takes the program and its words: `run PROGRAM WORDS...`")
        mut at_rule: usize = vec.length(into.rules) - 1
        if where == in_step then
            under: step = vec.get(into.steps, vec.length(into.steps) - 1)
                else (problem)
                _ = problem
                fail report.refused
            end
            if not under.own then
                report.at_line(host, codes.line_shape, file, item.number,
                               ["step `", under.name, "` names the rule `",
                                under.rule_name,
                                "`, which says what it runs; put this `run` under that rule, or take the rule's name off the `step` line"])
                fail report.refused
            end if
            at_rule = under.rule_at
        end if
        last: ptr mut rule = vec.at(into.rules, at_rule) else (problem)
            _ = problem
            fail report.refused
        end
        if last.val.run_number > 0 then
            report.at_line(host, codes.said_twice, file, item.number,
                           ["a second `run` line in ", kind_of(last.val), " `",
                            last.val.name,
                            "`; one `run` line runs one program, so make a second step for the second"])
            fail report.refused
        end if
        last.val.run_number = item.number
        for word in words[1..<lenof words] do
            try vec.push(last.val.run, memory, word)
        end for
    elsif strings.same(keyword, "set") then
        try wants(host, file, item.number, where <> nowhere,
                  "`set` belongs to a rule or a step; write it on a line after one")
        try wants(host, file, item.number, given == 2,
                  "`set` takes a name and one value: `set NAME VALUE`; quote a value with spaces")
        try wants(host, file, item.number, strings.is_segment(words[1]),
                  "a `set` name is lowercase letters, digits and `_`")
        try wants(host, file, item.number,
                  not strings.same(words[1], "in")
                  and not strings.same(words[1], "out"),
                  "`{in}` and `{out}` are the tool's own; choose another name")
        made: setting = (name: words[1], value: words[2],
                         number: item.number)
        if where == in_rule then
            last: ptr mut rule = vec.at(into.rules, vec.length(into.rules) - 1)
                else (problem)
                _ = problem
                fail report.refused
            end
            for other in vec.used(last.val.sets) do
                try unlike(host, file, item.number, "set", other.name,
                           words[1])
            end for
            try vec.push(last.val.sets, memory, made)
        else
            last: ptr mut step = vec.at(into.steps, vec.length(into.steps) - 1)
                else (problem)
                _ = problem
                fail report.refused
            end
            for other in vec.used(last.val.sets) do
                try unlike(host, file, item.number, "set", other.name,
                           words[1])
            end for
            try vec.push(last.val.sets, memory, made)
        end if
    elsif strings.same(keyword, "default") then
        where = nowhere
        try wants(host, file, item.number, given >= 1,
                  "`default` takes the steps to run when none is asked for: `default STEP...`")
        try vec.push(default_names, memory, item)
    else
        report.at_line(host, codes.keyword_unknown, file, item.number,
                       ["unknown keyword `", keyword,
                        "`; a recipe line starts with rule, run, set, step or default, and a comment with `--` and a space"])
        fail report.refused
    end if
end read_line

--  What a rule is called where it is spoken of: a step's own is the step.
kind_of: (how: rule) -> (word: []u8) =
    word = if how.own then "step" else "rule" end if
end kind_of

--  Refuse the line with `otherwise` unless `holds`.
wants: (host: blocking.host, file: []u8, number: usize, holds: bool,
        otherwise: []u8) -> none ! report.refused =
    return when holds
    report.at_line(host, codes.line_shape, file, number, [otherwise])
    fail report.refused
end wants

--  Refuse a name that is already taken among its kind.
unlike: (host: blocking.host, file: []u8, number: usize, kind: []u8,
         taken: []u8, name: []u8) -> none ! report.refused =
    return when not strings.same(taken, name)
    report.at_line(host, codes.said_twice, file, number,
                   ["a second `", kind, " ", name,
                    "`; give one of the two another name"])
    fail report.refused
end unlike
